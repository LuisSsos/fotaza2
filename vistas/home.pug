extends layout

block contenido
  h2.mb-4 Bienvenido #{usuario.nombre_usuario}
  .row
    each pub in publicaciones
      .col-md-4.mb-4
        .card
          .card-body
            h5.card-title #{pub.titulo}
            p.card-text.text-muted por #{pub.nombre_usuario}
            a.btn.btn-primary.btn-sm(href='/publicaciones/' + pub.id) Ver