extends layout

block contenido
  h2.text-warning Siguiendo
  br
  if publicaciones.length === 0
    p.text-light No hay publicaciones todavia
  .row
    each pub in publicaciones
      .col-md-4.mb-4
        .card.hl-card
          .card-body.hl-card-body
            h5.text-warning #{pub.titulo}
            p.text-light por #{pub.nombre_usuario}
            a.btn-hl-small(href='/publicaciones/' + pub.id) Ver
  br
  a.btn-hl-small(href='/') Volver