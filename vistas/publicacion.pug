extends layout

block contenido
  .row
    .col-md-8
      .card.hl-card.mb-4
        .card-body.hl-card-body
          h2.text-warning #{publicacion.titulo}
          p.text-muted por 
            a.text-warning(href='/usuarios/' + publicacion.id_autor) #{publicacion.nombre_usuario}
          if publicacion.descripcion
            p.text-light #{publicacion.descripcion}
      
      each imagen in imagenes
        .card.hl-card.mb-4
          img.card-img-top(src=imagen.nombre_archivo style='max-width: 100%; border-bottom: 2px solid #4a5043;')
          .card-body.hl-card-body
            p.text-light Valoracion: #{imagen.promedio} (#{imagen.total_votos} votos)
            form(method='POST' action=`/publicaciones/${publicacion.id}/imagen/${imagen.id}/valorar`)
              .input-group.w-50
                select.form-select.bg-dark.text-light.border-secondary(name='valor')
                  option(value='1') 1
                  option(value='2') 2
                  option(value='3') 3
                  option(value='4') 4
                  option(value='5') 5
                button.btn-hl-small(type='submit') Valorar
            a.btn-hl-danger(href='/denuncias/imagen/' + imagen.id + '?id_publicacion=' + publicacion.id) Denunciar
      
      hr.border-secondary
      h4.text-warning Comentarios
      each com in comentarios
        .card.hl-card.mb-2
          .card-body.hl-card-body
            p.mb-0.text-light
              strong.text-warning #{com.nombre_usuario}
              |  #{com.contenido}
            small.text-muted #{com.fecha}
      
      hr.border-secondary
      form(method='POST' action='/publicaciones/' + publicacion.id + '/comentar')
        .mb-3
          textarea.form-control.bg-dark.text-light.border-secondary(name='contenido' placeholder='Escribí un comentario' rows='2')
        button.btn-hl-small(type='submit') Comentar
        
      br
      a.btn-hl-small(href='/') Volver