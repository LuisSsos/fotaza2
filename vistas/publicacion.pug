extends layout

block contenido
  .row
    .col-md-8
      .card.hl-card.mb-4
        .card-body.hl-card-body
          h2(style="color: var(--hl-orange); text-shadow: 0 0 8px var(--hl-orange-glow); font-family: 'Share Tech Mono', monospace;") #{publicacion.titulo}
          if etiquetas.length > 0
            .mb-2
              each etiq in etiquetas
                span.badge.me-1(style='background-color: var(--hl-orange); color: #000; font-family: "Share Tech Mono", monospace; border-radius: 0;') #{etiq.nombre}
          p.text-muted por 
            a(href='/usuarios/' + publicacion.id_autor style="color: var(--hl-orange); text-decoration: none;") #{publicacion.nombre_usuario}
          if publicacion.descripcion
            p.text-light #{publicacion.descripcion}
      
      each imagen in imagenes
        .card.hl-card.mb-4
          img.card-img-top(src=imagen.nombre_archivo style='max-width: 100%; border-bottom: 2px solid var(--hl-border); border-radius: 0;')
          .card-body.hl-card-body
            p(style='color: var(--hl-orange); font-family: "Share Tech Mono", monospace;') Valoracion: #{imagen.promedio} (#{imagen.total_votos} votos)
            if usuario
              .d-flex.flex-wrap.align-items-start.gap-2.mt-3
                form.m-0(method='POST' action=`/publicaciones/${publicacion.id}/imagen/${imagen.id}/valorar`)
                  .d-flex(style="border: 2px solid var(--hl-border); background-color: #0c0d0b;")
                    select(name='valor' style="background-color: #0c0d0b; color: var(--hl-orange); border: none; outline: none; padding: 0 15px; font-family: 'Share Tech Mono', monospace; cursor: pointer; appearance: none; -webkit-appearance: none; -moz-appearance: none; font-weight: bold;")
                      option(value='1' style="background-color: #0c0d0b; color: var(--hl-orange);") 1
                      option(value='2' style="background-color: #0c0d0b; color: var(--hl-orange);") 2
                      option(value='3' style="background-color: #0c0d0b; color: var(--hl-orange);") 3
                      option(value='4' style="background-color: #0c0d0b; color: var(--hl-orange);") 4
                      option(value='5' style="background-color: #0c0d0b; color: var(--hl-orange);") 5
                    button.btn-hl-small(type='submit' style="border: none; margin: 0; min-width: auto;") Valorar
                form.m-0(method='POST' action='/intereses/imagen/' + imagen.id)
                  button.btn-hl-small(type='submit') Me interesa
                form.m-0(method='GET' action='/colecciones/seleccionar')
                  input(type='hidden' name='id_publicacion' value=publicacion.id)
                  button.btn-hl-small(type='submit') Guardar en coleccion
                a.btn-hl-danger(href='/denuncias/imagen/' + imagen.id + '?id_publicacion=' + publicacion.id style="display: flex; align-items: center; justify-content: center;") Denunciar
                if usuario.id == publicacion.id_autor
                  form.m-0(method='POST' action='/publicaciones/' + publicacion.id + '/comentarios/toggle')
                    button.btn-hl-small(type='submit')= publicacion.comentarios_abiertos ? 'Cerrar comentarios' : 'Abrir comentarios'
                  form.m-0(method='POST' action='/publicaciones/' + publicacion.id + '/eliminar' onsubmit='return confirm("¿Seguro que queres eliminar esta publicacion?")')
                    button.btn-hl-danger(type='submit') Eliminar publicacion
      
      hr(style="border-color: var(--hl-border); opacity: 1;")
      h4(style="color: var(--hl-orange); text-shadow: 0 0 5px var(--hl-orange-glow); font-family: 'Share Tech Mono', monospace;") Comentarios
      each com in comentarios
        .card.hl-card.mb-2(style="border-radius: 0;")
          .card-body.hl-card-body
            p.mb-0.text-light
              strong(style="color: var(--hl-orange);") #{com.nombre_usuario}
              |  #{com.contenido}
            small.text-muted(style="font-family: 'Share Tech Mono', monospace;") #{com.fecha}
      
      if usuario
        if publicacion.comentarios_abiertos
          hr(style="border-color: var(--hl-border); opacity: 1;")
          form(method='POST' action='/publicaciones/' + publicacion.id + '/comentar')
            .mb-3
              textarea(name='contenido' placeholder='Escribi un comentario...' rows='2' style="width: 100%; background-color: #0c0d0b; color: var(--hl-orange); border: 2px solid var(--hl-border); padding: 10px; outline: none; font-family: 'Share Tech Mono', monospace; resize: vertical;")
            button.btn-hl-small(type='submit') Comentar
        else
          p.mt-3(style="color: rgba(245, 124, 0, 0.5); font-style: italic; font-family: 'Share Tech Mono', monospace;") Comentarios cerrados
      else
        p.mt-3(style="color: rgba(245, 124, 0, 0.5); font-family: 'Share Tech Mono', monospace;") Iniciá sesion para comentar
        
      br
      a.btn-hl-small(href='/') Volver