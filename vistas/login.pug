extends layout

block contenido
  .row.justify-content-center.mt-5
    .col-md-5
      .card.hl-card
        .card-body.hl-card-body.text-center
          h2.mb-4.text-warning Iniciar sesión
          if error
            .alert.alert-danger #{error}
          form(method='POST' action='/auth/login')
            .mb-3
              label.text-light Correo Electronico 
              input.form-control.bg-dark.text-light.border-secondary(type='email' name='correo' placeholder='Correo')
            .mb-3
              label.text-light Contraseña
              input.form-control.bg-dark.text-light.border-secondary(type='password' name='contrasena' placeholder='Contraseña')
            button.btn-hl-small.w-100.mb-3(type='submit') Entrar
          a.text-warning(href='/auth/registro') No tengo cuenta