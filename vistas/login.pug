extends layout

block contenido
  .row.justify-content-center
    .col-md-4
      h2.mb-4 Iniciar sesion
      if error
        .alert.alert-danger #{error}
      form(method='POST' action='/auth/login')
        .mb-3
          input.form-control(type='email' name='correo' placeholder='Correo')
        .mb-3
          input.form-control(type='password' name='contrasena' placeholder='Contrasena')
        button.btn.btn-primary.w-100(type='submit') Entrar
      .mt-3
        a(href='/auth/registro') No tengo cuenta