html
  head
    title Fotaza 2 - Terminal
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css')
    link(rel='stylesheet' href='/css/estilos.css')
  body
    .d-flex.viewport-completo
      
      if usuario
        aside.sidebar-hl
          .sidebar-logo Fotaza 2
            span.lambda λ
          ul.nav.flex-column.mt-4
            li.nav-item: a.nav-link(href='/') ◖ Inicio
            li.nav-item: a.nav-link(href='/buscar') ◖ Buscar
            
            if noLeidas > 0
              li.nav-item: a.nav-link.alerta-lateral(href='/notificaciones') ◖ Notificaciones (#{noLeidas})
            else
              li.nav-item: a.nav-link(href='/notificaciones') ◖ Notificaciones
              
            li.nav-item: a.nav-link(href='/publicaciones/nueva') ◖ Nueva Publicación

      main.contenido-principal.flex-grow-1
        if usuario
          
          nav.navbar.topbar-hl.px-4.mb-4
            .d-flex.w-100.justify-content-end.gap-3
              
              if noLeidas > 0
                a.btn-hl-small.btn-hl-alert(href='/notificaciones') Notificaciones (#{noLeidas})
              else
                a.btn-hl-small(href='/notificaciones') Notificaciones
                
              a.btn-hl-small(href='/publicaciones/nueva') Nueva Publicación
              a.btn-hl-small(href='/perfil') Perfil
              a.btn-hl-danger(href='/auth/logout') Salir
        
        .container-fluid
          block contenido
    
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')