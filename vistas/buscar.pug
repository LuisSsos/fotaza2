extends layout

block contenido
  h2.mb-4(style="color: var(--hl-orange); text-shadow: 0 0 8px var(--hl-orange-glow);") BUSCAR
  form.mb-4(method='GET' action='/buscar')
    .input-group
      input.form-control.pipboy-input(type='text' name='q' value=termino placeholder='BUSCAR PUBLICACIONES...')
      button.btn-hl-small(type='submit') BUSCAR
  a.btn-hl-small.mb-3(href='/') VOLVER
  
  if termino && termino.trim() !== ''
    h5.mb-3(style="color: var(--hl-orange);") Resultados para: #{termino}
    if resultados.length === 0
      p(style="color: rgba(245, 124, 0, 0.7);") No se encontraron publicaciones
    .row
      each pub in resultados
        .col-md-4.mb-4
          .card.hl-card
            .card-body.hl-card-body
              h5.card-title(style="color: var(--hl-orange); text-shadow: 0 0 5px var(--hl-orange-glow);") #{pub.titulo}
              p.card-text(style="color: rgba(245, 124, 0, 0.8);") por #{pub.nombre_usuario}
              a.btn-hl-small.w-100(href='/publicaciones/' + pub.id) VER