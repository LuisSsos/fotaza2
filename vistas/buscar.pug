extends layout

block contenido
  h2.mb-4 Buscar
  form.mb-4(method='GET' action='/buscar')
    .input-group
      input.form-control(type='text' name='q' value=termino placeholder='Buscar publicaciones...')
      button.btn.btn-primary(type='submit') Buscar
  if termino
    h5.mb-3 Resultados para: #{termino}
    if resultados.length === 0
      p No se encontraron publicaciones
    .row
      each pub in resultados
        .col-md-4.mb-4
          .card
            .card-body
              h5.card-title #{pub.titulo}
              p.card-text.text-muted por #{pub.nombre_usuario}
              a.btn.btn-primary.btn-sm(href='/publicaciones/' + pub.id) Ver